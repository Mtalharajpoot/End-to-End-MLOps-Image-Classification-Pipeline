# GPU training image:  docker build -f Dockerfile.train -t visionops-train .
#                      docker run --gpus all -v $PWD/outputs:/workspace/outputs visionops-train --lr 3e-4
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN pip install --no-cache-dir -e ".[train,tracking]"
ENTRYPOINT ["python", "-m", "visionops.train"]
CMD ["--config", "configs/default.yaml"]
